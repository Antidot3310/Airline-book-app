<Window x:Class="AirlineTicketOffice.Wpf.Views.RoleSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авиакасса — выбор роли"
        Width="560"
        Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid Margin="48,40,48,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Авиакасса"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}" />

        <TextBlock Grid.Row="1"
                   Text="Выберите роль для входа в систему"
                   FontSize="15"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,8,0,0" />

        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <Button Content="Войти как Кассир"
                    Command="{Binding LoginAsCashierCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,0,14" />

            <Button Content="Войти как Администратор"
                    Command="{Binding LoginAsAdministratorCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       MinHeight="36"
                       Margin="0,16,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="Вход выполняется без пароля. Сеанс фиксируется в журнале аудита."
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextAlignment="Center"
                   HorizontalAlignment="Center" />
    </Grid>
</Window>
