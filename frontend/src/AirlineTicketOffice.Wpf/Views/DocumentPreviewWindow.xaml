<Window x:Class="AirlineTicketOffice.Wpf.Views.DocumentPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AirlineTicketOffice.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:DocumentPreviewViewModel}"
        Title="{Binding Title, StringFormat='Предпросмотр документа — {0}'}"
        Width="920" Height="720"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 1. Шапка документа -->
            <RowDefinition Height="Auto" />
            <!-- 2. Моноширинная область текста макета -->
            <RowDefinition Height="*" />
            <!-- 3. Панель действий (Печать, Сохранить, Закрыть) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Шапка документа -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📄  " FontSize="20" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <Border Background="{StaticResource PrimaryLightBrush}"
                            CornerRadius="6"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding DocumentNumber}"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{StaticResource PrimaryDarkBrush}" />
                    </Border>
                </StackPanel>

                <!-- Дата формирования -->
                <TextBlock Grid.Column="1"
                           Text="{Binding CreatedAtText, StringFormat='Сформирован: {0}'}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 2. Моноширинная область текста макета документа (Consolas) -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                Margin="0,0,0,16">
            <TextBox Text="{Binding FormattedContent, Mode=OneWay}"
                     IsReadOnly="True"
                     FontFamily="Consolas, Cascadia Mono, Courier New, monospace"
                     FontSize="13"
                     Foreground="#212121"
                     Background="White"
                     BorderThickness="0"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     Padding="12" />
        </Border>

        <!-- 3. Панель действий -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Кнопка «Печать» -->
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding PrintCommand}"
                            Padding="20,10"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨  " />
                            <TextBlock Text="Печать документа" />
                        </StackPanel>
                    </Button>

                    <!-- Кнопка «Сохранить в файл» -->
                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding SaveToFileCommand}"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾  " />
                            <TextBlock Text="Сохранить в файл (.txt)" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Кнопка «Закрыть» -->
                <Button Grid.Column="1"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding CloseCommand}"
                        Padding="20,10"
                        VerticalAlignment="Center">
                    <TextBlock Text="Закрыть" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
