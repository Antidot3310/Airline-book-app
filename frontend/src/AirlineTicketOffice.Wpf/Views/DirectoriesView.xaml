<UserControl x:Class="AirlineTicketOffice.Wpf.Views.DirectoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AirlineTicketOffice.Wpf.ViewModels"
             xmlns:dir="clr-namespace:AirlineTicketOffice.Core.Contracts.Directory;assembly=AirlineTicketOffice.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DirectoriesViewModel}">

    <UserControl.Resources>
        <!-- Стили кнопок сегментированных вкладок -->
        <Style x:Key="TabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabAirportsStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTabAirports}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabAircraftsStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTabAircrafts}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabAircraftTypesStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTabAircraftTypes}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabTariffsStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTabTariffs}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Шапка раздела -->
            <RowDefinition Height="Auto" />
            <!-- 2. Баннер уведомлений -->
            <RowDefinition Height="Auto" />
            <!-- 3. Вкладки -->
            <RowDefinition Height="Auto" />
            <!-- 4. Основное содержимое вкладок -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Шапка -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📚  " FontSize="20" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Справочники авиакомпании (W-11)"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding RefreshDataCommand}"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄  " />
                        <TextBlock Text="Обновить справочники" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 2. Баннер уведомлений -->
        <Border Grid.Row="1"
                Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ℹ️  " FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 3. Вкладки-переключатели -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4"
                HorizontalAlignment="Left"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Button Content="Аэропорты"
                        Style="{StaticResource TabAirportsStyle}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="0"
                        Margin="0,0,4,0" />
                <Button Content="Парк воздушных судов (Борта)"
                        Style="{StaticResource TabAircraftsStyle}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="1"
                        Margin="0,0,4,0" />
                <Button Content="Типы воздушных судов"
                        Style="{StaticResource TabAircraftTypesStyle}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="2"
                        Margin="0,0,4,0" />
                <Button Content="Тарифы и классы"
                        Style="{StaticResource TabTariffsStyle}"
                        Command="{Binding SelectTabCommand}"
                        CommandParameter="3" />
            </StackPanel>
        </Border>

        <!-- 4. Содержимое вкладок -->
        <Grid Grid.Row="3">
            <!-- ВКЛАДКА 0: АЭРОПОРТЫ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabAirports}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <!-- Таблица аэропортов -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <!-- Форма добавления аэропорта -->
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Таблица аэропортов -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Реестр аэропортов маршрутной сети"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   Margin="0,0,0,12" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Airports}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEEEEE"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="IATA-код" Binding="{Binding Code}" FontWeight="Bold" Width="100" />
                                <DataGridTextColumn Header="Город" Binding="{Binding City}" FontWeight="SemiBold" Width="150" />
                                <DataGridTextColumn Header="Название аэропорта" Binding="{Binding Name}" Width="*" />
                                <DataGridTemplateColumn Header="Статус" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type dir:AirportDto}">
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#4CAF50" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Background" Value="#9E9E9E" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Активен" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Text" Value="Деактивирован" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Действие" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type dir:AirportDto}">
                                            <Button Style="{StaticResource OutlineButtonStyle}"
                                                    Content="Деактивировать"
                                                    Command="{Binding DataContext.DeactivateAirportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsActive}"
                                                    Padding="8,4"
                                                    FontSize="11" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Форма добавления аэропорта -->
                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Visibility="{Binding CanManageDirectories, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <TextBlock Text="Добавить новый аэропорт"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   Margin="0,0,0,16" />

                        <TextBlock Text="IATA-код аэропорта (3 буквы) *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewAirportCode, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="3"
                                 Height="36"
                                 Padding="8,6"
                                 FontSize="13"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="Город расположения *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewAirportCity, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Padding="8,6"
                                 FontSize="13"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="Официальное наименование *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewAirportName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Padding="8,6"
                                 FontSize="13"
                                 Margin="0,0,0,20" />

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddAirportCommand}"
                                Height="40">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕  " />
                                <TextBlock Text="Добавить аэропорт" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ВКЛАДКА 1: ПАРК СУДОВ (БОРТА) -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabAircrafts}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Флот воздушных судов авиакомпании"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock Text="Борт на техобслуживании нельзя назначить на рейс (W-12)."
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CanManageDirectories, Converter={StaticResource BoolToVisConverter}}">
                            <TextBox Text="{Binding NewAircraftTailNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Width="150"
                                     Height="34"
                                     Padding="8,6"
                                     FontSize="12"
                                     ToolTip="Бортовой номер (например, RA-89014)"
                                     Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding AircraftTypes}"
                                      SelectedItem="{Binding NewAircraftType}"
                                      DisplayMemberPath="Name"
                                      Width="210"
                                      Height="34"
                                      FontSize="12"
                                      ToolTip="Тип воздушного судна"
                                      Margin="0,0,8,0" />
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddAircraftCommand}"
                                    Height="34"
                                    Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕  " />
                                    <TextBlock Text="Добавить борт" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AircraftList}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Бортовой номер" Binding="{Binding TailNumber}" FontWeight="Bold" Width="160" />
                            <DataGridTextColumn Header="Модель воздушного судна" Binding="{Binding AircraftTypeName}" FontWeight="SemiBold" Width="*" />
                            <DataGridTemplateColumn Header="Эксплуатационный статус" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dir:AircraftDto}">
                                        <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#4CAF50" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                                                            <Setter Property="Background" Value="#FF9800" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="В строю (InService)" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                                                                <Setter Property="Text" Value="Техобслуживание (Maintenance)" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Действие" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dir:AircraftDto}">
                                        <Button Command="{Binding DataContext.ToggleAircraftStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,6"
                                                FontSize="11">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                                    <Setter Property="Content" Value="🛠 На техобслуживание" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Maintenance">
                                                            <Setter Property="Content" Value="✅ Ввести в строй" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ВКЛАДКА 2: ТИПЫ ВОЗДУШНЫХ СУДОВ -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabAircraftTypes}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Справочник моделей и компоновок типов воздушных судов"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock Text="Пассажировместимость рассчитывается по схеме рядов: бизнес 2+2 (4 места), эконом 3+3 (6 мест)."
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    Visibility="{Binding CanManageDirectories, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Модель ВС" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                <TextBox Text="{Binding NewAircraftTypeName, UpdateSourceTrigger=PropertyChanged}"
                                         Width="210"
                                         Height="30"
                                         Padding="8,4"
                                         FontSize="12"
                                         ToolTip="Например, Airbus A320-200" />
                            </StackPanel>

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Рядов бизнес" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                <TextBox Text="{Binding NewAircraftTypeBusinessRows, UpdateSourceTrigger=PropertyChanged}"
                                         Width="70"
                                         Height="30"
                                         Padding="8,4"
                                         FontSize="12"
                                         ToolTip="Количество рядов бизнес-класса (4 кресла в ряду)" />
                            </StackPanel>

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Рядов эконом" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                <TextBox Text="{Binding NewAircraftTypeEconomyRows, UpdateSourceTrigger=PropertyChanged}"
                                         Width="70"
                                         Height="30"
                                         Padding="8,4"
                                         FontSize="12"
                                         ToolTip="Количество рядов эконом-класса (6 кресел в ряду)" />
                            </StackPanel>

                            <Border Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="6"
                                    Padding="10,7"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding NewAircraftTypeTotalSeats, StringFormat='Итого: {0} мест'}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryDarkBrush}" />
                            </Border>

                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddAircraftTypeCommand}"
                                    Height="30"
                                    Padding="12,0"
                                    VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕  " />
                                    <TextBlock Text="Добавить тип" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AircraftTypes}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Модель типа ВС" Binding="{Binding Name}" FontWeight="Bold" Width="*" />
                            <DataGridTextColumn Header="Пассажировместимость" Binding="{Binding TotalSeats, StringFormat='{}{0} мест'}" FontWeight="SemiBold" Width="180" />
                            <DataGridTextColumn Header="Рядов бизнеса" Binding="{Binding BusinessRowsCount}" Width="140" />
                            <DataGridTextColumn Header="Рядов эконома" Binding="{Binding EconomyRowsCount}" Width="140" />
                            <DataGridTemplateColumn Header="Статус" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type dir:AircraftTypeDto}">
                                        <Border Background="#4CAF50" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="Активен" Foreground="White" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ВКЛАДКА 3: ТАРИФЫ И КЛАССЫ ОБСЛУЖИВАНИЯ -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTabTariffs}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Таблица тарифов направлений -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Тарифная сетка направлений (справочно)"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock Text="Базовые ставки эконом-класса и сбор за багаж. Изменение тарифов выполняется в разделе «Управление тарифами» (W-13)."
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Tariffs}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEEEEE"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Вылет" Binding="{Binding OriginAirportCode}" FontWeight="Bold" Width="90" />
                                <DataGridTextColumn Header="Прилёт" Binding="{Binding DestinationAirportCode}" FontWeight="Bold" Width="90" />
                                <DataGridTextColumn Header="Базовый тариф (эконом)" Binding="{Binding BasePrice, StringFormat='{}{0:N0} ₽'}" FontWeight="SemiBold" Width="*" />
                                <DataGridTextColumn Header="Сбор за багаж" Binding="{Binding BaggageFee, StringFormat='{}{0:N0} ₽'}" Width="170" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Справка по классам обслуживания -->
                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SurfaceBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Классы обслуживания"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{StaticResource PrimaryDarkBrush}" />
                        <TextBlock Text="Множители применяются к базовому тарифу направления (M5)."
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,16"
                                   TextWrapping="Wrap" />

                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Эконом" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Компоновка 3+3" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="× 1.0"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Background="#FFF3E0"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Бизнес" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Компоновка 2+2" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="× 2.0"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentDarkBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Коэффициенты срочности (M5)"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   Margin="0,0,0,6" />
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Более 30 дней до вылета — ×1.0; 15–30 дней — ×1.2; 7–15 дней — ×1.5; менее 7 дней — ×1.8. Сбор за багаж добавляется к итоговой стоимости фиксированной суммой." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
