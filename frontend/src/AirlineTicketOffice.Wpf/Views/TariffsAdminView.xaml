<UserControl x:Class="AirlineTicketOffice.Wpf.Views.TariffsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AirlineTicketOffice.Wpf.ViewModels"
             xmlns:tariffs="clr-namespace:AirlineTicketOffice.Core.Contracts.Tariffs;assembly=AirlineTicketOffice.Core"
             xmlns:dir="clr-namespace:AirlineTicketOffice.Core.Contracts.Directory;assembly=AirlineTicketOffice.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TariffsAdminViewModel}">

    <UserControl.Resources>
        <DataTemplate x:Key="AirportComboTemplate" DataType="{x:Type dir:AirportDto}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding City}" FontWeight="SemiBold" />
                <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                <TextBlock Text=")" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Шапка раздела -->
            <RowDefinition Height="Auto" />
            <!-- 2. Баннер уведомлений -->
            <RowDefinition Height="Auto" />
            <!-- 3. Основная рабочая область (2 части: 60% и 40%) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Шапка -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏷  " FontSize="20" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Управление тарифами и сборами (W-13)"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding RefreshDataCommand}"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄  " />
                        <TextBlock Text="Обновить тарифы" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 2. Баннер уведомлений -->
        <Border Grid.Row="1"
                Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ℹ️  " FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 3. Двухпанельная рабочая область -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Левая панель: Таблица тарифов и редактирование (1.3*) -->
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="16" />
                <!-- Правая панель: Интерактивный калькулятор (*) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ: Таблица базовых тарифов -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Базовая тарифная сетка маршрутов авиакомпании"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               Margin="0,0,0,12" />

                    <!-- Таблица тарифов -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Tariffs}"
                              SelectedItem="{Binding SelectedTariff}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="42">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Маршрут" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type tariffs:TariffDto}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OriginAirportCode}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                            <TextBlock Text=" ➔ " Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding DestinationAirportCode}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Базовый тариф (Эконом)" Binding="{Binding BasePrice, StringFormat='{}{0:N0} ₽'}" FontWeight="SemiBold" Width="*" />
                            <DataGridTextColumn Header="Сбор за багаж (23 кг)" Binding="{Binding BaggageFee, StringFormat='{}{0:N0} ₽'}" Width="160" />

                            <DataGridTemplateColumn Header="Действие" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type tariffs:TariffDto}">
                                        <Button Style="{StaticResource OutlineButtonStyle}"
                                                Content="Изменить"
                                                Command="{Binding DataContext.SelectTariffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4"
                                                FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Разделитель -->
                    <Border Grid.Row="2" Height="1" Background="{StaticResource SurfaceBorderBrush}" Margin="0,12,0,12" />

                    <!-- Панель быстрого редактирования тарифа -->
                    <Border Grid.Row="3"
                            Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedTariff, StringFormat='Редактирование тарифа: {0}'}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                       Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Базовая цена (₽) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditBasePrice, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36"
                                             Padding="8,6"
                                             FontSize="13" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Сбор за багаж (₽) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding EditBaggageFee, UpdateSourceTrigger=PropertyChanged}"
                                             Height="36"
                                             Padding="8,6"
                                             FontSize="13" />
                                </StackPanel>

                                <Button Grid.Column="4"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveTariffCommand}"
                                        Height="36"
                                        Padding="16,0"
                                        VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💾  " />
                                        <TextBlock Text="Сохранить" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ПРАВАЯ ПАНЕЛЬ: Интерактивный калькулятор -->
            <Border Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Интерактивный проверочный калькулятор (M5)"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Моделирование формулы динамического ценообразования с учётом класса, срочности и багажа."
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,14" />

                        <!-- Откуда -->
                        <TextBlock Text="Аэропорт вылета" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Airports}"
                                  SelectedItem="{Binding CalcOriginAirport}"
                                  ItemTemplate="{StaticResource AirportComboTemplate}"
                                  Height="36"
                                  Margin="0,0,0,10" />

                        <!-- Куда -->
                        <TextBlock Text="Аэропорт назначения" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Airports}"
                                  SelectedItem="{Binding CalcDestinationAirport}"
                                  ItemTemplate="{StaticResource AirportComboTemplate}"
                                  Height="36"
                                  Margin="0,0,0,10" />

                        <!-- Класс обслуживания -->
                        <TextBlock Text="Класс обслуживания" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="Эконом (× 1.0)"
                                    Command="{Binding SelectEconomyClassCommand}"
                                    Height="34"
                                    Padding="4"
                                    FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CalcSeatClass}" Value="Economy">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="2"
                                    Content="Бизнес (× 2.0)"
                                    Command="{Binding SelectBusinessClassCommand}"
                                    Height="34"
                                    Padding="4"
                                    FontSize="12">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CalcSeatClass}" Value="Business">
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Дата вылета -->
                        <TextBlock Text="Дата вылета" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding CalcDepartureDate}" Height="36" Margin="0,0,0,10" />

                        <!-- Чекбокс багажа -->
                        <CheckBox Content="Добавить платное место багажа (23 кг)"
                                  IsChecked="{Binding CalcHasBaggage}"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Margin="0,4,0,16" />

                        <!-- Карточка результатов расчёта -->
                        <Border Background="#E8F5E9"
                                BorderBrush="{StaticResource SuccessBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Итоговая расчётная стоимость билета"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#2E7D32"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{Binding CalculatedFinalPrice, StringFormat='{}{0:N0} ₽'}"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="#2E7D32"
                                           Margin="0,0,0,8" />

                                <Border Height="1" Background="#A5D6A7" Margin="0,4,0,8" />

                                <!-- Детализированный разбор формулы -->
                                <TextBlock Text="{Binding FormulaExplanation}"
                                           FontSize="11"
                                           FontFamily="Consolas, Courier New, monospace"
                                           Foreground="#1B5E20"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
