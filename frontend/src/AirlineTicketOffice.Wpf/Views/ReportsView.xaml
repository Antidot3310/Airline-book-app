<UserControl x:Class="AirlineTicketOffice.Wpf.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AirlineTicketOffice.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ReportsViewModel}">

    <UserControl.Resources>
        <!-- Стили кнопок переключения типов отчёта -->
        <Style x:Key="ReportTypeBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TypeFlightLoadStyle" TargetType="Button" BasedOn="{StaticResource ReportTypeBtnStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTypeFlightLoad}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeRouteRevenueStyle" TargetType="Button" BasedOn="{StaticResource ReportTypeBtnStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTypeRouteRevenue}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeChannelSalesStyle" TargetType="Button" BasedOn="{StaticResource ReportTypeBtnStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTypeChannelSales}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeRefundStatsStyle" TargetType="Button" BasedOn="{StaticResource ReportTypeBtnStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTypeRefundStats}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль кнопок быстрого выбора периода -->
        <Style x:Key="QuickPeriodButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Компактная карточка сводного показателя -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <!-- Оверлей поверх области отчёта по условию из ViewModel -->
        <Style x:Key="OverlayBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="32" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Панель параметров и действий -->
            <RowDefinition Height="Auto" />
            <!-- 2. Баннер уведомлений -->
            <RowDefinition Height="Auto" />
            <!-- 3. Основная область отображения отчёта -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Панель параметров отчёта -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок, период и кнопки -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊  " FontSize="20" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Аналитические отчёты (W-14)"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ReportPeriodText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDarkBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ReportSubtitle}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding VirtualNowText}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding GenerateReportCommand}"
                                IsEnabled="{Binding CanViewReports}"
                                Padding="16,8"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄  " />
                                <TextBlock Text="Сформировать отчёт" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding PrintReportCommand}"
                                IsEnabled="{Binding HasReportData}"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨  " />
                                <TextBlock Text="Печать / Экспорт (W-10)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Период и переключатель типов отчёта -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Период с:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <DatePicker SelectedDate="{Binding FromDate}" Width="128" Height="32" />
                        </StackPanel>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="по:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <DatePicker SelectedDate="{Binding ToDate}" Width="128" Height="32" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Быстрый период:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Сутки" Style="{StaticResource QuickPeriodButtonStyle}"
                                        Command="{Binding SetQuickPeriodCommand}" CommandParameter="0" Margin="0,0,6,0" />
                                <Button Content="7 дней" Style="{StaticResource QuickPeriodButtonStyle}"
                                        Command="{Binding SetQuickPeriodCommand}" CommandParameter="7" Margin="0,0,6,0" />
                                <Button Content="30 дней" Style="{StaticResource QuickPeriodButtonStyle}"
                                        Command="{Binding SetQuickPeriodCommand}" CommandParameter="30" />
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>

                    <Border Grid.Row="1"
                            Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Загрузка рейсов" Style="{StaticResource TypeFlightLoadStyle}"
                                    Command="{Binding SelectReportTypeCommand}" CommandParameter="0" Margin="0,0,4,0" />
                            <Button Content="Выручка направлений" Style="{StaticResource TypeRouteRevenueStyle}"
                                    Command="{Binding SelectReportTypeCommand}" CommandParameter="1" Margin="0,0,4,0" />
                            <Button Content="Продажи по каналам" Style="{StaticResource TypeChannelSalesStyle}"
                                    Command="{Binding SelectReportTypeCommand}" CommandParameter="2" Margin="0,0,4,0" />
                            <Button Content="Статистика возвратов" Style="{StaticResource TypeRefundStatsStyle}"
                                    Command="{Binding SelectReportTypeCommand}" CommandParameter="3" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Баннер уведомлений -->
        <Border Grid.Row="1"
                Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ℹ️  " FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 3. Основная область отображения отчёта -->
        <Grid Grid.Row="2">

            <!-- 3.1. Отчёт по загрузке рейсов -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTypeFlightLoad}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Рейсов в выборке" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding FlightLoadReport.TotalFlights}" FontWeight="Bold" FontSize="18"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Мест всего" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding FlightLoadReport.TotalCapacity}" FontWeight="Bold" FontSize="18"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Продано мест" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding FlightLoadReport.TotalSoldSeats}" FontWeight="Bold" FontSize="18"
                                           Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#E8F5E9" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Средняя загрузка" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" />
                                <TextBlock Text="{Binding FlightLoadReport.AverageLoadPercentage, StringFormat='{}{0:F1} %'}"
                                           FontWeight="Bold" FontSize="18" Foreground="#2E7D32" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FlightLoadRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Рейс" Binding="{Binding FlightNumber}" FontWeight="Bold" Width="90" />
                            <DataGridTextColumn Header="Маршрут" Binding="{Binding Route}" FontWeight="SemiBold" Width="110" />
                            <DataGridTextColumn Header="Вылет" Binding="{Binding DepartureText}" Width="135" />
                            <DataGridTextColumn Header="Воздушное судно" Binding="{Binding AircraftModel}" Width="145" />
                            <DataGridTextColumn Header="Всего мест" Binding="{Binding TotalSeats}" Width="85" />
                            <DataGridTextColumn Header="Продано" Binding="{Binding SeatsText}" FontWeight="SemiBold" Width="90" />
                            <DataGridTextColumn Header="Бизнес (продано/всего)" Binding="{Binding BusinessLoadText}" Width="175" />
                            <DataGridTextColumn Header="Эконом (продано/всего)" Binding="{Binding EconomyLoadText}" Width="175" />
                            <DataGridTemplateColumn Header="Загрузка" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" ToolTip="{Binding LoadLevelText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0"
                                                         Value="{Binding LoadPercentage, Mode=OneWay}"
                                                         Maximum="100"
                                                         Height="8"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         Background="#E3F2FD"
                                                         BorderThickness="0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LoadPercentText}"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHighLoad}" Value="True">
                                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsLowLoad}" Value="True">
                                                                <Setter Property="Foreground" Value="#EF6C00" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 3.2. Отчёт по выручке направлений -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTypeRouteRevenue}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Билетов продано" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RouteRevenueReport.TotalTicketsSold}" FontWeight="Bold" FontSize="18"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Валовая выручка" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RouteRevenueReport.TotalGrossRevenue, StringFormat='{}{0:N0} ₽'}"
                                           FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#FFEBEE" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Сумма возвратов" FontSize="11" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Text="{Binding RouteRevenueReport.TotalRefundedAmount, StringFormat='-{0:N0} ₽'}"
                                           FontWeight="Bold" FontSize="18" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#E8F5E9" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Чистая выручка" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" />
                                <TextBlock Text="{Binding RouteRevenueReport.TotalNetRevenue, StringFormat='{}{0:N0} ₽'}"
                                           FontWeight="Bold" FontSize="18" Foreground="#2E7D32" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RouteRevenueRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Маршрут" Binding="{Binding Route}" FontWeight="Bold" Width="120" />
                            <DataGridTextColumn Header="Города направления" Binding="{Binding CitiesText}" Width="240" />
                            <DataGridTextColumn Header="Продано билетов" Binding="{Binding TicketsSold}" Width="125" />
                            <DataGridTextColumn Header="Валовая выручка" Binding="{Binding GrossRevenueText}" FontWeight="SemiBold" Width="*" />
                            <DataGridTextColumn Header="Сумма возвратов" Binding="{Binding RefundedAmountText}"
                                                Foreground="{StaticResource DangerBrush}" Width="*" />
                            <DataGridTemplateColumn Header="Чистая выручка" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NetRevenueText}" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2E7D32" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLossMaking}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Средний билет" Binding="{Binding AverageTicketPriceText}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 3.3. Отчёт по продажам в разрезе каналов -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTypeChannelSales}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Всего заказов" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ChannelSalesReport.TotalOrders}" FontWeight="Bold" FontSize="18"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Всего билетов" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ChannelSalesReport.TotalTickets}" FontWeight="Bold" FontSize="18"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#E8F5E9" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Общая выручка каналов" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" />
                                <TextBlock Text="{Binding ChannelSalesReport.TotalRevenue, StringFormat='{}{0:N0} ₽'}"
                                           FontWeight="Bold" FontSize="18" Foreground="#2E7D32" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Билеты по каналам" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Касса: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ChannelSalesReport.CashierTicketsCount}" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="  •  Самообслуживание: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ChannelSalesReport.SelfServiceTicketsCount}" FontSize="11" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ChannelSalesRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Канал оформления" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ChannelIcon}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ChannelName}" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="110" />
                            <DataGridTextColumn Header="Билетов" Binding="{Binding TicketsCount}" Width="110" />
                            <DataGridTextColumn Header="Выручка" Binding="{Binding TotalSalesAmountText}" FontWeight="Bold" Width="*" />
                            <DataGridTextColumn Header="Доля в выручке" Binding="{Binding RevenueShareText}" FontWeight="SemiBold"
                                                Foreground="{StaticResource PrimaryDarkBrush}" Width="150" />
                            <DataGridTextColumn Header="Средний билет" Binding="{Binding AverageTicketText}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 3.4. Отчёт по статистике возвратов -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTypeRefundStats}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Всего возвратов" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RefundStatisticsReport.TotalRefundsCount}" FontWeight="Bold" FontSize="18"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFEBEE" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Выплачено клиентам" FontSize="11" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Text="{Binding RefundStatisticsReport.TotalRefundAmount, StringFormat='{}{0:N0} ₽'}"
                                           FontWeight="Bold" FontSize="18" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#E8F5E9" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Удержано штрафов" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" />
                                <TextBlock Text="{Binding RefundStatisticsReport.TotalPenaltyAmount, StringFormat='{}{0:N0} ₽'}"
                                           FontWeight="Bold" FontSize="18" Foreground="#2E7D32" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock Text="По основаниям" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Добровольные: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding RefundStatisticsReport.VoluntaryRefundsCount}" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="  •  Отмена рейса: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding RefundStatisticsReport.FlightCancellationRefundsCount}" FontSize="11" FontWeight="Bold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RefundStatisticsRows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Основание возврата" Width="260">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ReasonIcon}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ReasonName}" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Количество возвратов" Binding="{Binding RefundsCount}" Width="170" />
                            <DataGridTextColumn Header="Выплачено клиентам" Binding="{Binding TotalRefundAmountText}" FontWeight="Bold"
                                                Foreground="{StaticResource DangerBrush}" Width="*" />
                            <DataGridTextColumn Header="Удержано штрафов" Binding="{Binding TotalPenaltyAmountText}" FontWeight="SemiBold"
                                                Foreground="#2E7D32" Width="*" />
                            <DataGridTextColumn Header="Доля штрафов" Binding="{Binding PenaltyShareText}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 3.5. Оверлей отсутствия данных -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource OverlayBorderStyle}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasReportData}" Value="False" />
                                    <Condition Binding="{Binding IsLoading}" Value="False" />
                                    <Condition Binding="{Binding IsAccessDenied}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="📭" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Данные отчёта отсутствуют"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 3.6. Оверлей отказа в доступе -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource OverlayBorderStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAccessDenied}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                    <TextBlock Text="🔒" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Раздел недоступен для текущей роли"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding AccessDeniedMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 3.7. Индикатор формирования отчёта -->
            <Border Background="#E6FFFFFF"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="220" Height="6" Foreground="{StaticResource PrimaryBrush}"
                                 Background="#E3F2FD" BorderThickness="0" Margin="0,0,0,12" />
                    <TextBlock Text="Формирование отчёта…"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
