<UserControl x:Class="AirlineTicketOffice.Wpf.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AirlineTicketOffice.Wpf.ViewModels"
             xmlns:reports="clr-namespace:AirlineTicketOffice.Core.Contracts.Reports;assembly=AirlineTicketOffice.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ReportsViewModel}">

    <UserControl.Resources>
        <!-- Стили кнопок переключения типов отчёта -->
        <Style x:Key="ReportTypeBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TypeFlightLoadStyle" TargetType="Button" BasedOn="{StaticResource ReportTypeBtnStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTypeFlightLoad}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeRouteRevenueStyle" TargetType="Button" BasedOn="{StaticResource ReportTypeBtnStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTypeRouteRevenue}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeChannelSalesStyle" TargetType="Button" BasedOn="{StaticResource ReportTypeBtnStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTypeChannelSales}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TypeRefundStatsStyle" TargetType="Button" BasedOn="{StaticResource ReportTypeBtnStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTypeRefundStats}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Панель параметров и действий -->
            <RowDefinition Height="Auto" />
            <!-- 2. Баннер уведомлений -->
            <RowDefinition Height="Auto" />
            <!-- 3. Основная область отображения отчёта -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Панель параметров отчёта -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок и кнопки экспорта -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊  " FontSize="20" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Аналитические отчёты (W-14)"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding GenerateReportCommand}"
                                Padding="16,8"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄  " />
                                <TextBlock Text="Сформировать отчёт" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding PrintReportCommand}"
                                Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨  " />
                                <TextBlock Text="Печать / Экспорт (W-10)" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Выбор дат и переключатель вкладок отчёта -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Выбор периода дат -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Период с:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <DatePicker SelectedDate="{Binding FromDate}" Width="130" Height="34" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="по:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <DatePicker SelectedDate="{Binding ToDate}" Width="130" Height="34" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Переключатели типов отчётов -->
                    <Border Grid.Column="2"
                            Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Загрузка рейсов"
                                    Style="{StaticResource TypeFlightLoadStyle}"
                                    Command="{Binding SelectReportTypeCommand}"
                                    CommandParameter="0"
                                    Margin="0,0,4,0" />
                            <Button Content="Выручка по направлениям"
                                    Style="{StaticResource TypeRouteRevenueStyle}"
                                    Command="{Binding SelectReportTypeCommand}"
                                    CommandParameter="1"
                                    Margin="0,0,4,0" />
                            <Button Content="Продажи по каналам"
                                    Style="{StaticResource TypeChannelSalesStyle}"
                                    Command="{Binding SelectReportTypeCommand}"
                                    CommandParameter="2"
                                    Margin="0,0,4,0" />
                            <Button Content="Статистика возвратов"
                                    Style="{StaticResource TypeRefundStatsStyle}"
                                    Command="{Binding SelectReportTypeCommand}"
                                    CommandParameter="3" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Баннер уведомлений -->
        <Border Grid.Row="1"
                Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ℹ️  " FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 3. Основная область отображения отчёта -->
        <Grid Grid.Row="2">
            <!-- 3.1. ОТЧЁТ: ЗАГРУЗКА РЕЙСОВ -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTypeFlightLoad}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Сводные карточки -->
                        <RowDefinition Height="Auto" />
                        <!-- Таблица деталей -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Сводные показатели загрузки -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Всего рейсов" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding FlightLoadReport.TotalFlights}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Вместимость (мест)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding FlightLoadReport.TotalCapacity}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Продано мест" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding FlightLoadReport.TotalSoldSeats}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#E8F5E9" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Средняя загрузка" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" />
                                <TextBlock Text="{Binding FlightLoadReport.AverageLoadPercentage, StringFormat='{}{0:F1} %'}" FontWeight="Bold" FontSize="18" Foreground="#2E7D32" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Таблица деталей по рейсам -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FlightLoadReport.Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Рейс" Binding="{Binding FlightNumber}" FontWeight="Bold" Width="100" />
                            <DataGridTextColumn Header="Маршрут" Binding="{Binding Route}" FontWeight="SemiBold" Width="160" />
                            <DataGridTextColumn Header="Вылет" Binding="{Binding DepartureTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="150" />
                            <DataGridTextColumn Header="Вместимость" Binding="{Binding Capacity}" Width="120" />
                            <DataGridTextColumn Header="Бизнес (продано)" Binding="{Binding BusinessSoldSeats}" Width="140" />
                            <DataGridTextColumn Header="Эконом (продано)" Binding="{Binding EconomySoldSeats}" Width="140" />
                            <DataGridTextColumn Header="Всего продано" Binding="{Binding TotalSoldSeats}" FontWeight="Bold" Width="130" />
                            <DataGridTextColumn Header="Загрузка (%)" Binding="{Binding LoadPercentage, StringFormat='{}{0:F1} %'}" FontWeight="Bold" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 3.2. ОТЧЁТ: ВЫРУЧКА ПО НАПРАВЛЕНИЯМ -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTypeRouteRevenue}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Сводные показатели выручки -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Билетов продано" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RouteRevenueReport.TotalTicketsSold}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Валовая выручка" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RouteRevenueReport.TotalGrossRevenue, StringFormat='{}{0:N0} ₽'}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#FFEBEE" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Сумма возвратов" FontSize="11" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Text="{Binding RouteRevenueReport.TotalRefundedAmount, StringFormat='-{}{0:N0} ₽'}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="6" Background="#E8F5E9" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Чистая выручка" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" />
                                <TextBlock Text="{Binding RouteRevenueReport.TotalNetRevenue, StringFormat='{}{0:N0} ₽'}" FontWeight="Bold" FontSize="18" Foreground="#2E7D32" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Таблица по направлениям -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RouteRevenueReport.Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Маршрут перелёта" Binding="{Binding Route}" FontWeight="Bold" Width="180" />
                            <DataGridTextColumn Header="Продано билетов" Binding="{Binding TicketsSold}" Width="140" />
                            <DataGridTextColumn Header="Валовая выручка" Binding="{Binding GrossRevenue, StringFormat='{}{0:N0} ₽'}" FontWeight="SemiBold" Width="*" />
                            <DataGridTextColumn Header="Сумма возвратов" Binding="{Binding RefundedAmount, StringFormat='{}{0:N0} ₽'}" Foreground="{StaticResource DangerBrush}" Width="*" />
                            <DataGridTextColumn Header="Чистая выручка" Binding="{Binding NetRevenue, StringFormat='{}{0:N0} ₽'}" FontWeight="Bold" Foreground="#2E7D32" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 3.3. ОТЧЁТ: ПРОДАЖИ ПО КАНАЛАМ -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTypeChannelSales}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Сводные показатели по каналам -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Всего заказов" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ChannelSalesReport.TotalOrders}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Всего билетов" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding ChannelSalesReport.TotalTickets}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#E8F5E9" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Общая выручка каналов" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" />
                                <TextBlock Text="{Binding ChannelSalesReport.TotalRevenue, StringFormat='{}{0:N0} ₽'}" FontWeight="Bold" FontSize="18" Foreground="#2E7D32" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Таблица по каналам -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ChannelSalesReport.Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Канал оформления" Binding="{Binding ChannelName}" FontWeight="Bold" Width="220" />
                            <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="140" />
                            <DataGridTextColumn Header="Билетов" Binding="{Binding TicketsCount}" Width="140" />
                            <DataGridTextColumn Header="Выручка" Binding="{Binding Revenue, StringFormat='{}{0:N0} ₽'}" FontWeight="Bold" Width="*" />
                            <DataGridTextColumn Header="Доля в выручке (%)" Binding="{Binding RevenueSharePercentage, StringFormat='{}{0:F1} %'}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 3.4. ОТЧЁТ: СТАТИСТИКА ВОЗВРАТОВ -->
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTypeRefundStats}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Сводные показатели возвратов -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Всего возвратов (шт.)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding RefundStatisticsReport.TotalRefundsCount}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFEBEE" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Выплачено клиентам" FontSize="11" Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Text="{Binding RefundStatisticsReport.TotalRefundAmount, StringFormat='{}{0:N0} ₽'}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="#E8F5E9" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Удержано штрафов" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" />
                                <TextBlock Text="{Binding RefundStatisticsReport.TotalPenaltyAmount, StringFormat='{}{0:N0} ₽'}" FontWeight="Bold" FontSize="18" Foreground="#2E7D32" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Таблица причин возвратов -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RefundStatisticsReport.Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="44">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Основание / Причина возврата" Binding="{Binding ReasonDescription}" FontWeight="Bold" Width="260" />
                            <DataGridTextColumn Header="Возвращено билетов" Binding="{Binding RefundsCount}" Width="160" />
                            <DataGridTextColumn Header="Сумма выплат клиентам" Binding="{Binding RefundAmount, StringFormat='{}{0:N0} ₽'}" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Width="*" />
                            <DataGridTextColumn Header="Сумма удержанных штрафов" Binding="{Binding PenaltyAmount, StringFormat='{}{0:N0} ₽'}" FontWeight="SemiBold" Foreground="#2E7D32" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
