<UserControl x:Class="AirlineTicketOffice.Wpf.Views.FlightsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AirlineTicketOffice.Wpf.ViewModels"
             xmlns:dir="clr-namespace:AirlineTicketOffice.Core.Contracts.Directory;assembly=AirlineTicketOffice.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FlightsAdminViewModel}">

    <UserControl.Resources>
        <DataTemplate x:Key="AirportComboTemplate" DataType="{x:Type dir:AirportDto}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding City}" FontWeight="SemiBold" />
                <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                <TextBlock Text=")" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AircraftOptionTemplate" DataType="{x:Type vm:AircraftOptionViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TailNumber}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                <TextBlock Text=" — " Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding AircraftTypeName}" />
                <TextBlock Text="{Binding StatusText, StringFormat=' ({0})'}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🗓  " FontSize="20" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Управление рейсами и расписанием (W-12)"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}" />
                        <TextBlock Text="Создание рейса, замена воздушного судна и отмена с массовым возвратом"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{Binding VirtualNowText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                            <TextBlock Text="Загрузка расписания..."
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartCreateFlightCommand}"
                            IsEnabled="{Binding CanManageFlights}"
                            Padding="16,8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕  " />
                            <TextBlock Text="Создать рейс" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding RefreshDataCommand}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄  " />
                            <TextBlock Text="Обновить" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BANNERS -->
        <Border Grid.Row="1"
                Background="#FFF3E0"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,12"
                Visibility="{Binding IsReadOnlyMode, Converter={StaticResource BoolToVisConverter}}">
            <TextBlock Text="Режим только для чтения: у текущего сеанса нет права «Управление рейсами» (ManageFlights). Создание, замена борта и отмена рейсов недоступны."
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#E65100"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ℹ️  " FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- PANELS -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCreatingFlight}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="Форма создания нового рейса"
                           FontWeight="Bold"
                           FontSize="15"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Посадочные места генерируются автоматически по схеме выбранного типа воздушного судна. Борт на техобслуживании назначить нельзя (TC-11)."
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Номер рейса *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewFlightNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34"
                                 Padding="8,6"
                                 FontSize="13"
                                 ToolTip="Например, SU-105" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Откуда (вылет) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding OriginAirports}"
                                  SelectedItem="{Binding SelectedOriginAirport}"
                                  ItemTemplate="{StaticResource AirportComboTemplate}"
                                  Height="34" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Куда (прилёт) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding DestinationAirports}"
                                  SelectedItem="{Binding SelectedDestinationAirport}"
                                  ItemTemplate="{StaticResource AirportComboTemplate}"
                                  Height="34" />
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Воздушное судно (борт) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableAircraftList}"
                                  SelectedItem="{Binding SelectedAircraft}"
                                  ItemTemplate="{StaticResource AircraftOptionTemplate}"
                                  Height="34" />
                    </StackPanel>
                </Grid>

                <!-- CREATE_TAIL -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Дата вылета *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding DepartureDate}" Height="34" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Время (ЧЧ:ММ) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DepartureTimeText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,6" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Дата прилёта *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding ArrivalDate}" Height="34" />
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Время (ЧЧ:ММ) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ArrivalTimeText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,6" />
                    </StackPanel>

                    <TextBlock Grid.Column="7"
                               Text="Вылет должен быть позже виртуального времени ядра, прилёт — позже вылета."
                               FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Bottom"
                               Margin="8,0,0,8" />
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CreateFlightCommand}"
                            Padding="18,9"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✈  " />
                            <TextBlock Text="Сохранить и сгенерировать места" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding CancelCreateFlightCommand}"
                            Padding="16,9">
                        <TextBlock Text="Отмена" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CHANGE_PANEL -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChangingAircraft}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="{Binding ChangeAircraftTitle}"
                           FontWeight="Bold"
                           FontSize="15"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           Margin="0,0,0,4" />

                <TextBlock FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14">
                    <Run Text="Маршрут: " />
                    <Run Text="{Binding FlightForAircraftChange.RouteText, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=" • Вылет: " />
                    <Run Text="{Binding FlightForAircraftChange.DepartureText, Mode=OneWay}" />
                    <Run Text=" • Текущий борт: " />
                    <Run Text="{Binding FlightForAircraftChange.AircraftText, Mode=OneWay}" />
                    <LineBreak />
                    <Run Text="Смена борта запрещена, если на рейс уже проданы или забронированы билеты (TC-10)." />
                </TextBlock>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Новый борт из доступных в строю *"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding ReplacementAircraftList}"
                                  SelectedItem="{Binding SelectedNewAircraft}"
                                  ItemTemplate="{StaticResource AircraftOptionTemplate}"
                                  Height="36" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding ConfirmChangeAircraftCommand}"
                                Height="36"
                                Padding="18,0"
                                Margin="0,0,10,0">
                            <TextBlock Text="Подтвердить замену борта" />
                        </Button>

                        <Button Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding CancelChangeAircraftCommand}"
                                Height="36"
                                Padding="16,0">
                            <TextBlock Text="Отмена" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- FILTERS -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0" ItemsSource="{Binding StatusFilters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FlightStatusFilterOption}">
                                <Button Content="{Binding DisplayTitle}"
                                        Command="{Binding DataContext.SelectStatusFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="12,6"
                                        Margin="0,0,6,0"
                                        FontSize="12">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Column="1"
                            Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding ResetFiltersCommand}"
                            Content="Сбросить фильтры"
                            Padding="10,6"
                            FontSize="11"
                            Margin="8,0,0,0" />
                </Grid>

                <!-- FILTER_ROW2 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox Text="{Binding FilterFlightNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Padding="8,5"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Поиск по номеру рейса, коду или городу" />
                        <TextBlock Text="Номер рейса, код или город..."
                                   IsHitTestVisible="False"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilterFlightNumber}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <CheckBox Grid.Column="1"
                              Content="Фильтр по дате"
                              IsChecked="{Binding FilterByDateEnabled}"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Margin="14,0,8,0" />

                    <DatePicker Grid.Column="2"
                                SelectedDate="{Binding FilterDate}"
                                IsEnabled="{Binding FilterByDateEnabled}"
                                Width="130"
                                Height="32" />

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="5" Padding="8,4" Margin="0,0,5,0">
                            <TextBlock Text="{Binding TotalFlightsText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                        </Border>
                        <Border Background="#E8F5E9" CornerRadius="5" Padding="8,4" Margin="0,0,5,0">
                            <TextBlock Text="{Binding ScheduledFlightsText}" FontSize="10" FontWeight="SemiBold" Foreground="#2E7D32" />
                        </Border>
                        <Border Background="#E3F2FD" CornerRadius="5" Padding="8,4" Margin="0,0,5,0">
                            <TextBlock Text="{Binding DepartedFlightsText}" FontSize="10" FontWeight="SemiBold" Foreground="#1565C0" />
                        </Border>
                        <Border Background="#FFEBEE" CornerRadius="5" Padding="8,4">
                            <TextBlock Text="{Binding CancelledFlightsText}" FontSize="10" FontWeight="SemiBold" Foreground="#C62828" />
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- TABLE -->
        <Border Grid.Row="5"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10">
            <Grid>
                <DataGrid ItemsSource="{Binding FilteredFlights}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE"
                          Background="Transparent"
                          BorderThickness="0"
                          RowHeight="58"
                          ColumnHeaderHeight="34"
                          FontSize="12">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Рейс" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FlightAdminRowViewModel}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FlightNumber}"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource PrimaryDarkBrush}" />
                                        <TextBlock Text="{Binding DepartureRelativeText}"
                                                   FontSize="9"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Маршрут" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FlightAdminRowViewModel}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RouteText}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryDarkBrush}" />
                                        <TextBlock Text="{Binding CitiesText}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Воздушное судно" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FlightAdminRowViewModel}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AircraftText}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding AircraftText}" />
                                        <TextBlock Text="{Binding DurationText, StringFormat='В полёте: {0}'}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- COLUMN4 -->
                        <DataGridTemplateColumn Header="Вылет / прилёт" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FlightAdminRowViewModel}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DepartureText}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ArrivalText, StringFormat='→ {0}'}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Места" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FlightAdminRowViewModel}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SeatsText}" FontSize="10" FontWeight="SemiBold" />
                                        <ProgressBar Value="{Binding OccupancyPercent}"
                                                     Maximum="100"
                                                     Height="6"
                                                     Margin="0,4,0,0"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Background="#E3F2FD"
                                                     BorderThickness="0"
                                                     ToolTip="Заполняемость борта" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Статус" Width="112">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FlightAdminRowViewModel}">
                                    <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#4CAF50" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Departed">
                                                        <Setter Property="Background" Value="#2196F3" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                        <Setter Property="Background" Value="#E53935" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ACTIONS_COLUMN -->
                        <DataGridTemplateColumn Header="Действия" Width="175">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:FlightAdminRowViewModel}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource OutlineButtonStyle}"
                                                Command="{Binding DataContext.OpenChangeAircraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanChangeAircraft}"
                                                Padding="7,4"
                                                FontSize="10"
                                                Margin="0,0,5,0"
                                                ToolTip="Заменить воздушное судно (TC-09/10)">
                                            <TextBlock Text="🔄 Борт" />
                                        </Button>

                                        <Button Command="{Binding DataContext.CancelFlightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanCancel}"
                                                Padding="7,4"
                                                FontSize="10"
                                                ToolTip="Отменить рейс с массовым 100% возвратом (TC-08)">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="❌ Отменить" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Рейсы не найдены. Измените параметры фильтра или создайте новый рейс."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="360"
                           TextAlignment="Center"
                           Visibility="{Binding HasNoFlights, Converter={StaticResource BoolToVisConverter}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
