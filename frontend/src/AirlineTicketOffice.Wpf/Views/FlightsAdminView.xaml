<UserControl x:Class="AirlineTicketOffice.Wpf.Views.FlightsAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AirlineTicketOffice.Wpf.ViewModels"
             xmlns:flights="clr-namespace:AirlineTicketOffice.Core.Contracts.Flights;assembly=AirlineTicketOffice.Core"
             xmlns:dir="clr-namespace:AirlineTicketOffice.Core.Contracts.Directory;assembly=AirlineTicketOffice.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FlightsAdminViewModel}">

    <UserControl.Resources>
        <DataTemplate x:Key="AirportComboTemplate" DataType="{x:Type dir:AirportDto}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding City}" FontWeight="SemiBold" />
                <TextBlock Text=" (" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                <TextBlock Text=")" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AircraftComboTemplate" DataType="{x:Type dir:AircraftDto}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding TailNumber}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                <TextBlock Text=" — " Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding AircraftTypeName}" />
                <TextBlock Text="{Binding Status, StringFormat=' ({0})'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Шапка и кнопки действий -->
            <RowDefinition Height="Auto" />
            <!-- 2. Баннер уведомлений -->
            <RowDefinition Height="Auto" />
            <!-- 3. Панель создания / смены борта (раскрывающаяся) -->
            <RowDefinition Height="Auto" />
            <!-- 4. Панель фильтров -->
            <RowDefinition Height="Auto" />
            <!-- 5. Таблица рейсов -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Шапка раздела -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🗓  " FontSize="20" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Управление рейсами и расписанием (W-12)"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartCreateFlightCommand}"
                            Padding="16,8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕  " />
                            <TextBlock Text="Создать рейс" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding RefreshDataCommand}"
                            Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄  " />
                            <TextBlock Text="Обновить" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Баннер уведомлений -->
        <Border Grid.Row="1"
                Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,0,0,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ℹ️  " FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 3. Панель создания рейса (раскрывается по IsCreatingFlight) -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCreatingFlight}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="Форма создания нового регулярного рейса"
                           FontWeight="Bold"
                           FontSize="15"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           Margin="0,0,0,16" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>

                    <!-- Номер рейса -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Номер рейса *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewFlightNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36"
                                 Padding="8,6"
                                 FontSize="13" />
                    </StackPanel>

                    <!-- Аэропорт вылета -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Откуда (вылет) *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding OriginAirports}"
                                  SelectedItem="{Binding SelectedOriginAirport}"
                                  ItemTemplate="{StaticResource AirportComboTemplate}"
                                  Height="36" />
                    </StackPanel>

                    <!-- Аэропорт назначения -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Куда (прилёт) *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding DestinationAirports}"
                                  SelectedItem="{Binding SelectedDestinationAirport}"
                                  ItemTemplate="{StaticResource AirportComboTemplate}"
                                  Height="36" />
                    </StackPanel>

                    <!-- Воздушное судно -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Воздушное судно (борт) *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableAircraftList}"
                                  SelectedItem="{Binding SelectedAircraft}"
                                  ItemTemplate="{StaticResource AircraftComboTemplate}"
                                  Height="36" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Дата вылета -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Дата вылета *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding DepartureDate}" Height="36" />
                    </StackPanel>

                    <!-- Время вылета -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Время вылета *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DepartureTimeStr, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6" />
                    </StackPanel>

                    <!-- Дата прилёта -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Дата прилёта *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding ArrivalDate}" Height="36" />
                    </StackPanel>

                    <!-- Время прилёта -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Время прилёта *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ArrivalTimeStr, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8,6" />
                    </StackPanel>
                </Grid>

                <!-- Кнопки формы -->
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CreateFlightCommand}"
                            Padding="20,10"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✈  " />
                            <TextBlock Text="Сохранить и сгенерировать места" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding CancelCreateFlightCommand}"
                            Padding="16,10">
                        <TextBlock Text="Отмена" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3.1. Панель смены борта (раскрывается по IsChangingAircraft) -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChangingAircraft}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <TextBlock Text="{Binding SelectedFlightForChangeAircraft.FlightNumber, StringFormat='Замена воздушного судна для рейса {0}'}"
                           FontWeight="Bold"
                           FontSize="15"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           Margin="0,0,0,12" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Выберите новый борт из доступных в строю (TC-09/10):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AvailableAircraftList}"
                                  SelectedItem="{Binding SelectedNewAircraft}"
                                  ItemTemplate="{StaticResource AircraftComboTemplate}"
                                  Height="38" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding ConfirmChangeAircraftCommand}"
                                Height="38"
                                Padding="18,0"
                                Margin="0,0,10,0">
                            <TextBlock Text="Подтвердить замену борта" />
                        </Button>

                        <Button Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding CancelChangeAircraftCommand}"
                                Height="38"
                                Padding="16,0">
                            <TextBlock Text="Отмена" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 4. Панель фильтров рейсов -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <!-- Вкладки фильтров статусов -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Все"
                            Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding FilterByStatusCommand}"
                            CommandParameter="0"
                            Padding="12,6"
                            Margin="0,0,6,0" />
                    <Button Content="Запланированные"
                            Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding FilterByStatusCommand}"
                            CommandParameter="1"
                            Padding="12,6"
                            Margin="0,0,6,0" />
                    <Button Content="Вылетели"
                            Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding FilterByStatusCommand}"
                            CommandParameter="2"
                            Padding="12,6"
                            Margin="0,0,6,0" />
                    <Button Content="Отменённые"
                            Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding FilterByStatusCommand}"
                            CommandParameter="3"
                            Padding="12,6" />
                </StackPanel>

                <!-- Поиск по номеру рейса -->
                <TextBox Grid.Column="2"
                         Text="{Binding FilterFlightNumber, UpdateSourceTrigger=PropertyChanged}"
                         Height="34"
                         Padding="8,6"
                         FontSize="12"
                         VerticalContentAlignment="Center" />
            </Grid>
        </Border>

        <!-- 5. Таблица рейсов -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
            <DataGrid ItemsSource="{Binding FilteredFlights}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="46">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Рейс" Binding="{Binding FlightNumber}" FontWeight="Bold" Width="100" />
                    <DataGridTemplateColumn Header="Маршрут" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type flights:FlightDetailsDto}">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding OriginAirportCode}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                        <TextBlock Text=" ➔ " Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding DestinationAirportCode}" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding OriginCity, StringFormat='{}{0}...'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Воздушное судно" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type flights:FlightDetailsDto}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AircraftTailNumber}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AircraftModel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Вылет" Binding="{Binding DepartureTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140" />
                    <DataGridTextColumn Header="Прилёт" Binding="{Binding ArrivalTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140" />

                    <DataGridTemplateColumn Header="Места (свободно)" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type flights:FlightDetailsDto}">
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                    <Run Text="{Binding AvailableSeats, Mode=OneWay}" Foreground="{StaticResource PrimaryDarkBrush}" />
                                    <Run Text=" / " Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Run Text="{Binding TotalSeats, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Статус" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type flights:FlightDetailsDto}">
                                <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#4CAF50" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Departed">
                                                    <Setter Property="Background" Value="#2196F3" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Background" Value="#E53935" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Действия кассира/администратора -->
                    <DataGridTemplateColumn Header="Действия" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type flights:FlightDetailsDto}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Сменить борт -->
                                    <Button Style="{StaticResource OutlineButtonStyle}"
                                            Command="{Binding DataContext.OpenChangeAircraftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4"
                                            FontSize="11"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="🔄 Борт" />
                                    </Button>

                                    <!-- Отменить рейс с 100% возвратом (TC-08) -->
                                    <Button Command="{Binding DataContext.CancelFlightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="8,4"
                                            FontSize="11">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButtonStyle}">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="❌ Отменить (100%)" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
