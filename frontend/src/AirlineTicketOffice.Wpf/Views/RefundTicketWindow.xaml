<Window x:Class="AirlineTicketOffice.Wpf.Views.RefundTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AirlineTicketOffice.Wpf.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:RefundTicketViewModel}"
        Title="{Binding TicketNumber, StringFormat='Возврат авиабилета — {0} (W-09)'}"
        Width="760" Height="620"
        MinWidth="700" MinHeight="550"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- 1. Заголовок окна -->
            <RowDefinition Height="Auto" />
            <!-- 2. Карточка информации о билете -->
            <RowDefinition Height="Auto" />
            <!-- 3. Карточка расчёта возврата и штрафа -->
            <RowDefinition Height="*" />
            <!-- 4. Предупреждение / Ошибки -->
            <RowDefinition Height="Auto" />
            <!-- 5. Панель действий -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Заголовок окна -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="↩  " FontSize="20" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Оформление возврата авиабилета (W-09)"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <Border Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="6"
                        Padding="8,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding TicketNumber}"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="{StaticResource PrimaryDarkBrush}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 2. Карточка информации о билете -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Маршрут и рейс -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RouteText}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="5"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding FlightNumber, StringFormat='Рейс {0}'}"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding DepartureTimeText, StringFormat='Вылет: {0}'}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Детали: Пассажир, Заказ, Исходная цена -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Пассажир" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding PassengerName}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding PassengerDocument, StringFormat='Паспорт: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Номер заказа" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="Стоимость билета" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding OriginalPrice, StringFormat='{}{0:N0} ₽'}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Карточка расчёта возврата и штрафа -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Расчёт суммы возврата (только чтение)"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           Margin="0,0,0,14" />

                <!-- Сетка параметров возврата -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Оставшееся время до вылета -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="14"
                            Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Время до вылета" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding TimeUntilDepartureText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Применяемое правило и процент -->
                    <Border Grid.Column="1"
                            Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="14"
                            Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Правило тарифа" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{Binding RefundBadgeColor}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RefundPercentText}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="White" />
                                </Border>
                                <TextBlock Text="{Binding RuleDescription}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Сумма удержания (штраф) -->
                    <Border Grid.Column="2"
                            Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="14"
                            Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Удержание (штраф)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding PenaltyAmount, StringFormat='{}{0:N0} ₽'}"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="{Binding PenaltyPercentText, StringFormat='Удержано {0} стоимости'}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Итоговая сумма к выдаче клиенту -->
                <Border Grid.Row="3"
                        Background="#E8F5E9"
                        BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Сумма к выдаче клиенту:"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#2E7D32" />
                            <TextBlock Text="Денежные средства подлежат выплате клиенту в полном объёме согласно чеку возврата."
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding RefundAmount, StringFormat='{}{0:N0} ₽'}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#2E7D32"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 4. Предупреждение / Сообщение об ошибке -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <!-- Предупреждение о необратимости -->
            <Border Background="#FFF3E0"
                    BorderBrush="{StaticResource AccentDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️  " FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Внимание! Операция возврата необратима: авиабилет переводится в статус «Возвращён», а место освобождается для повторной продажи."
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#E65100"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Баннер отсутствия прав на оформление возврата -->
            <Border Background="#FFF3E0"
                    BorderBrush="{StaticResource AccentDarkBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRefundPermission}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⛔  " FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Текущая роль не имеет права на оформление возврата (RefundTicket). Подтверждение заблокировано."
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#E65100"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Баннер ошибки -->
            <Border Background="#FFEBEE"
                    BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="❌  " FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 5. Панель действий -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Кнопка подтверждения возврата -->
                <Button Grid.Column="0"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding ConfirmRefundCommand}"
                        IsEnabled="{Binding CanConfirmRefund}"
                        Padding="20,10"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↩  " />
                        <TextBlock Text="Подтвердить возврат билета" />
                    </StackPanel>
                </Button>

                <!-- Кнопка отмены -->
                <Button Grid.Column="1"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding CancelCommand}"
                        Padding="20,10"
                        VerticalAlignment="Center">
                    <TextBlock Text="Отмена" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
