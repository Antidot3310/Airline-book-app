<Window x:Class="AirlineTicketOffice.Wpf.Views.EmulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AirlineTicketOffice.Wpf.ViewModels"
        xmlns:pay="clr-namespace:AirlineTicketOffice.Core.Contracts.Payments;assembly=AirlineTicketOffice.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:EmulatorViewModel}"
        Title="Служебный пульт управления эмулятором (W-16)"
        Width="960" Height="760"
        MinWidth="880" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 1. Заголовок пульта -->
            <RowDefinition Height="Auto" />
            <!-- 2. Баннер уведомлений -->
            <RowDefinition Height="Auto" />
            <!-- 3. Карточка 1: Управление временем -->
            <RowDefinition Height="Auto" />
            <!-- 4. Карточка 2: Платёжный шлюз -->
            <RowDefinition Height="*" />
            <!-- 5. Карточка 3: Ручной резолв таймаутов TC-15 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Заголовок окна -->
        <Border Grid.Row="0"
                Background="#263238"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎛️  " FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="Служебный пульт управления эмулятором (W-16)"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Border Background="#37474F" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="Служебный инструмент тестирования и демонстрации"
                                   FontSize="11"
                                   Foreground="#B0BEC5" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding CloseCommand}"
                        Padding="14,6"
                        Foreground="White"
                        BorderBrush="#546E7A">
                    <TextBlock Text="Закрыть" />
                </Button>
            </Grid>
        </Border>

        <!-- 2. Баннер уведомлений -->
        <Border Grid.Row="1"
                Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,8"
                Margin="0,0,0,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ℹ️  " FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 3. Карточка 1: Управление временем (M12) -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⏱  Виртуальное системное время: " FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentVirtualTimeText}"
                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentClockModeText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding TriggerJobsCommand}"
                            Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️  " />
                            <TextBlock Text="Выполнить регламентные задачи" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Кнопки быстрого сдвига времени -->
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding Advance15MinutesCommand}"
                            Padding="12,6"
                            Margin="0,0,8,0">
                        <TextBlock Text="⏩  +15 минут (снятие брони)" />
                    </Button>

                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding Advance1HourCommand}"
                            Padding="12,6"
                            Margin="0,0,8,0">
                        <TextBlock Text="⏩  +1 час" />
                    </Button>

                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding Advance1DayCommand}"
                            Padding="12,6"
                            Margin="0,0,8,0">
                        <TextBlock Text="⏩  +1 день" />
                    </Button>

                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding ResetTimeCommand}"
                            Padding="12,6">
                        <TextBlock Text="🔄  Сброс к реальному времени" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Карточка 2: Настройка платёжного шлюза (M14) -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Настройки режима и задержки -->
                    <RowDefinition Height="Auto" />
                    <!-- Разделитель -->
                    <RowDefinition Height="Auto" />
                    <!-- Журнал входящих запросов к шлюзу -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Выбор режима шлюза -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Режим обработки платёжных транзакций (M14):" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <ComboBox SelectedIndex="{Binding SelectedModeIndex}" Height="34">
                            <ComboBoxItem Content="✅ AlwaysSuccess — Всегда одобрение (успех 100%)" />
                            <ComboBoxItem Content="❌ AlwaysReject — Всегда отказ банка-эмитента" />
                            <ComboBoxItem Content="⏳ Timeout — Таймаут ответа (статус Indeterminate, TC-15)" />
                            <ComboBoxItem Content="🎲 Random — Случайный исход (50% успех / 50% отказ)" />
                        </ComboBox>
                    </StackPanel>

                    <!-- Слайдер искусственной задержки -->
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Искусственная задержка:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding DelayMilliseconds, StringFormat='{}{0} мс'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryDarkBrush}" HorizontalAlignment="Right" />
                        </Grid>
                        <Slider Minimum="0" Maximum="5000" SmallChange="100" LargeChange="500" Value="{Binding DelayMilliseconds}" Height="28" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Разделитель -->
                <Border Grid.Row="1" Height="1" Background="{StaticResource SurfaceBorderBrush}" Margin="0,0,0,10" />

                <!-- Журнал запросов к шлюзу -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Журнал входящих запросов к платёжному шлюзу" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource OutlineButtonStyle}"
                                    Command="{Binding RefreshRequestsCommand}"
                                    Padding="10,4"
                                    FontSize="11"
                                    Margin="0,0,8,0">
                                <TextBlock Text="🔄 Обновить" />
                            </Button>
                            <Button Style="{StaticResource OutlineButtonStyle}"
                                    Command="{Binding ClearLogCommand}"
                                    Padding="10,4"
                                    FontSize="11">
                                <TextBlock Text="🗑 Очистить" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding IncomingRequests}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" Width="90" />
                            <DataGridTextColumn Header="Заказ" Binding="{Binding OrderId, StringFormat='Заказ #{0}'}" FontWeight="SemiBold" Width="100" />
                            <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat='{}{0:N0} ₽'}" Width="100" />
                            <DataGridTextColumn Header="Карта" Binding="{Binding MaskedCardNumber}" Width="150" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" FontWeight="Bold" Width="120" />
                            <DataGridTextColumn Header="Внешний ID" Binding="{Binding ExternalTransactionId}" Width="160" />
                            <DataGridTextColumn Header="Сообщение шлюза" Binding="{Binding Message}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>

        <!-- 5. Карточка 3: Ручной резолв таймаутов TC-15 -->
        <Border Grid.Row="4"
                Background="#FFF8E1"
                BorderBrush="#FFE082"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Ручное подтверждение таймаутов (кейс TC-15)"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#F57F17" />
                        <TextBlock Text="Разрешение зависших платежей со статусом Indeterminate (после таймаута шлюза)."
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Поле ввода ID платежа -->
                    <TextBox Grid.Column="2"
                             Text="{Binding PendingPaymentId, UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Padding="8,6"
                             FontSize="13"
                             VerticalContentAlignment="Center" />

                    <!-- Подтвердить успех -->
                    <Button Grid.Column="4"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ResolveSuccessCommand}"
                            Height="34"
                            Padding="10,0"
                            Background="#2E7D32">
                        <TextBlock Text="✅ Успех" />
                    </Button>

                    <!-- Отклонить -->
                    <Button Grid.Column="6"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding ResolveRejectCommand}"
                            Height="34"
                            Padding="10,0"
                            Background="#C62828">
                        <TextBlock Text="❌ Отказ" />
                    </Button>
                </Grid>

                <!-- Сообщение результата резолва -->
                <Border Grid.Row="1"
                        Background="#FFFFFF"
                        BorderBrush="#FFD54F"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6"
                        Margin="0,8,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResolveMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ResolveMessage}" FontWeight="Bold" FontSize="12" Foreground="#E65100" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
