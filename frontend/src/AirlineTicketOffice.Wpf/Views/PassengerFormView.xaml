<UserControl x:Class="AirlineTicketOffice.Wpf.Views.PassengerFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AirlineTicketOffice.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PassengerFormViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Верхняя панель рейса -->
            <RowDefinition Height="Auto" />
            <!-- 2. Формы ввода данных пассажиров -->
            <RowDefinition Height="*" />
            <!-- 3. Ошибки / Предупреждения -->
            <RowDefinition Height="Auto" />
            <!-- 4. Нижний блок расчета и бронирования -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Верхняя панель рейса -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryLightBrush}"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding FlightNumber, StringFormat='Рейс {0}'}"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="{StaticResource PrimaryDarkBrush}" />
                    </Border>
                    <TextBlock Text="{Binding RouteInfo}"
                               FontWeight="Bold"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <TextBlock Text="{Binding DepartureTimeText, StringFormat='Вылет: {0}'}"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Кнопка «Назад к схеме мест» -->
                <Button Grid.Column="1"
                        Style="{StaticResource OutlineButtonStyle}"
                        Command="{Binding BackToSeatMapCommand}"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="← " FontWeight="Bold" />
                        <TextBlock Text="Назад к схеме мест" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 2. Формы ввода данных пассажиров (скроллируемый список) -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Passengers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PassengerItemViewModel}">
                            <Border Background="#FAFCFF"
                                    BorderBrush="{StaticResource SurfaceBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <!-- Шапка карточки пассажира -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Поля ввода -->
                                        <RowDefinition Height="Auto" />
                                        <!-- Опция багажа -->
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Шапка карточки пассажира -->
                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="👤  " FontSize="16" Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Text="{Binding HeaderText}"
                                                       FontWeight="Bold"
                                                       FontSize="15"
                                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                                        </StackPanel>

                                        <!-- Базовая стоимость билета -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding BaseSeatPrice, StringFormat='Тариф: {0:N0} ₽'}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Поля ввода данных пассажира -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <!-- ФИО -->
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="16" />
                                            <!-- Паспорт -->
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="16" />
                                            <!-- Телефон -->
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <!-- Email -->
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- ФИО -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="ФИО пассажира *"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,6" />
                                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="38"
                                                     Padding="10,8"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="13" />
                                        </StackPanel>

                                        <!-- Серия и номер паспорта -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Серия и номер документа *"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,6" />
                                            <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="38"
                                                     Padding="10,8"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="13" />
                                        </StackPanel>

                                        <!-- Телефон -->
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Контактный телефон"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,6" />
                                            <TextBox Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="38"
                                                     Padding="10,8"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="13" />
                                        </StackPanel>

                                        <!-- Email -->
                                        <StackPanel Grid.Column="6">
                                            <TextBlock Text="Электронная почта"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,0,6" />
                                            <TextBox Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="38"
                                                     Padding="10,8"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="13" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Опция багажа (+1500 руб.) -->
                                    <Border Grid.Row="2"
                                            Background="White"
                                            BorderBrush="{StaticResource SurfaceBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="14,10"
                                            Margin="0,16,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding HasBaggage, Mode=TwoWay}"
                                                      VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                                                    <TextBlock Text="🧳  Добавить платное место багажа (до 23 кг)"
                                                               FontWeight="Medium"
                                                               FontSize="13" />
                                                    <TextBlock Text=" (+1 500 ₽)"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryBrush}"
                                                               FontSize="13" />
                                                </StackPanel>
                                            </CheckBox>

                                            <!-- Итог по билету пассажира -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TicketPrice, StringFormat='Стоимость билета: {0:N0} ₽'}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 3. Сообщение об ошибке валидации -->
        <Border Grid.Row="2"
                Background="#FFEBEE"
                BorderBrush="#FFCDD2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️  " FontSize="16" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C62828"
                           FontWeight="Medium"
                           FontSize="14"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 4. Нижний блок расчета и бронирования -->
        <Border Grid.Row="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Расчёт сумм -->
                    <ColumnDefinition Width="*" />
                    <!-- Кнопка бронирования -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Билеты: " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding BaseTicketsTotal, StringFormat='{}{0:N0} ₽'}" FontWeight="SemiBold" FontSize="13" Margin="0,0,16,0" />

                        <TextBlock Text="Багаж: " FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding BaggageTotal, StringFormat='{}{0:N0} ₽'}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Итого к оплате: "
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OrderTotal, StringFormat='{}{0:N0} ₽'}"
                                   FontSize="24"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Кнопка «Забронировать и перейти к оплате» -->
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CreateOrderCommand}"
                        IsEnabled="{Binding IsSubmitting, Converter={x:Null}}"
                        Padding="28,14"
                        FontSize="15"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Забронировать и перейти к оплате →" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
