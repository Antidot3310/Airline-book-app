<UserControl x:Class="AirlineTicketOffice.Wpf.Views.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AirlineTicketOffice.Wpf.ViewModels"
             xmlns:orders="clr-namespace:AirlineTicketOffice.Core.Contracts.Orders;assembly=AirlineTicketOffice.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PaymentViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- 1. Баннер обратного отсчёта времени -->
            <RowDefinition Height="Auto" />
            <!-- 2. Сводка заказа -->
            <RowDefinition Height="Auto" />
            <!-- 3. Форма оплаты (карта / наличные) или результаты -->
            <RowDefinition Height="*" />
            <!-- 4. Статусные баннеры и ошибки -->
            <RowDefinition Height="Auto" />
            <!-- 5. Нижняя панель действий -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Крупный таймер обратного отсчёта времени бронирования -->
        <Border Grid.Row="0"
                CornerRadius="10"
                Padding="20,14"
                Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FFF8E1" />
                    <Setter Property="BorderBrush" Value="#FFE082" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpired}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE" />
                            <Setter Property="BorderBrush" Value="#EF9A9A" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPaid}" Value="True">
                            <Setter Property="Background" Value="#E8F5E9" />
                            <Setter Property="BorderBrush" Value="#A5D6A7" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="⏰ " FontSize="22" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Время действия бронирования мест (15 минут)"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding RemainingTimeText, StringFormat='Осталось времени на оплату: {0}'}"
                               FontSize="18"
                               FontWeight="Bold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#E65100" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                        <Setter Property="Foreground" Value="#C62828" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Сумма заказа к оплате -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="К оплате:"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N0} ₽'}"
                               FontSize="22"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Сводка заказа -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,14"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="8"
                        Padding="12,6"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding OrderNumber}"
                               FontWeight="Bold"
                               FontSize="15"
                               Foreground="{StaticResource PrimaryDarkBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FlightInfo}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding PassengersSummary, StringFormat='Пассажиры: {0}'}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Основная область: Формы оплаты (карта / наличные) ИЛИ билеты после оплаты -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24"
                Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- ВАРИАНТ А: До успешной оплаты (Форма ввода) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Переключатель способов оплаты (виден только для кассира) -->
                        <Border Background="#F8FAFC"
                                BorderBrush="{StaticResource SurfaceBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,10"
                                Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashier}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Способ приёма оплаты:  "
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           VerticalAlignment="Center" />

                                <RadioButton Content="💳 Банковская карта"
                                             IsChecked="{Binding IsCardMethod, Mode=OneWay}"
                                             Command="{Binding SelectCardMethodCommand}"
                                             FontWeight="Medium"
                                             FontSize="13"
                                             Margin="0,0,20,0"
                                             VerticalAlignment="Center" />

                                <RadioButton Content="💵 Наличные в кассе"
                                             IsChecked="{Binding IsCashMethod, Mode=OneWay}"
                                             Command="{Binding SelectCashMethodCommand}"
                                             FontWeight="Medium"
                                             FontSize="13"
                                             VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 1) Оплата банковской картой -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCardMethod}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Реквизиты банковской карты"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Foreground="{StaticResource PrimaryDarkBrush}"
                                           VerticalAlignment="Center" />

                                <!-- Кнопка быстрой подстановки тестовой карты -->
                                <Button Grid.Column="1"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Command="{Binding FillTestCardCommand}"
                                        Padding="12,6"
                                        FontSize="12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ " />
                                        <TextBlock Text="Подставить тестовую карту" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Поля карты -->
                            <Grid MaxWidth="500" HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Номер карты -->
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Номер карты *"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}"
                                             Height="38"
                                             Padding="10,8"
                                             FontSize="14" />
                                </StackPanel>

                                <!-- Держатель карты -->
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Имя держателя латиницей (CARDHOLDER) *"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding CardHolder, UpdateSourceTrigger=PropertyChanged}"
                                             Height="38"
                                             Padding="10,8"
                                             FontSize="14" />
                                </StackPanel>

                                <!-- Срок и CVV -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Месяц -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Месяц (MM) *"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,6" />
                                        <TextBox Text="{Binding ExpiryMonth, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38"
                                                 Padding="10,8"
                                                 FontSize="14" />
                                    </StackPanel>

                                    <!-- Год -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Год (YY) *"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,6" />
                                        <TextBox Text="{Binding ExpiryYear, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38"
                                                 Padding="10,8"
                                                 FontSize="14" />
                                    </StackPanel>

                                    <!-- CVV -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Код CVC/CVV *"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,0,6" />
                                        <TextBox Text="{Binding Cvv, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38"
                                                 Padding="10,8"
                                                 FontSize="14" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <!-- 2) Оплата наличными (кассир) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashMethod}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="Приём наличных средств в кассе"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{StaticResource PrimaryDarkBrush}"
                                       Margin="0,0,0,16" />

                            <Grid MaxWidth="440" HorizontalAlignment="Left">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Сумма от клиента -->
                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Внесено клиентом (руб.) *"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}"
                                             Height="42"
                                             FontSize="18"
                                             FontWeight="Bold"
                                             Padding="10,8" />
                                </StackPanel>

                                <!-- Сдача -->
                                <Border Grid.Row="2"
                                        Background="#E8F5E9"
                                        BorderBrush="#A5D6A7"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Сдача к выдаче:"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#2E7D32"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ChangeAmount, StringFormat='{}{0:N0} ₽'}"
                                                   FontSize="22"
                                                   FontWeight="ExtraBold"
                                                   Foreground="#1B5E20"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- ВАРИАНТ Б: Заказ успешно оплачен (Список билетов и печать) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Оформленные электронные билеты:"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="{StaticResource PrimaryDarkBrush}"
                                   Margin="0,0,0,16" />

                        <ItemsControl ItemsSource="{Binding Tickets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type orders:TicketDto}">
                                    <Border Background="#F1F8E9"
                                            BorderBrush="#C8E6C9"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Background="#2E7D32"
                                                    CornerRadius="6"
                                                    Padding="10,4"
                                                    Margin="0,0,16,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TicketNumber}"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           FontSize="13" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PassengerName}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="#1B5E20" />
                                                <TextBlock Text="{Binding PassengerDocument, StringFormat='Документ: {0}'}"
                                                           FontSize="12"
                                                           Foreground="#388E3C" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SeatNumber, StringFormat='Место: {0}'}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="#1B5E20"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding FinalPrice, StringFormat='{}{0:N0} ₽'}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#2E7D32"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 4. Статусные баннеры (Успех / Неопределённость / Ошибка) -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <!-- Успех -->
            <Border Background="#E8F5E9"
                    BorderBrush="#A5D6A7"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SuccessMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✔  " FontSize="18" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="#1B5E20"
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Баннер задержки шлюза (Indeterminate) с кнопкой ручной проверки (кейс TC-15) -->
            <Border Background="#FFF9C4"
                    BorderBrush="#FFF176"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIndeterminate}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="⏳ Платёж ожидает подтверждения платёжного шлюза (Indeterminate)"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#F57F17" />
                        <TextBlock Text="Шлюз задержал обработку транзакции. Нажмите «Проверить статус платежа» для ручной синхронизации."
                                   FontSize="12"
                                   Foreground="#795548"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding CheckPaymentStatusCommand}"
                            Padding="16,8"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " />
                            <TextBlock Text="Проверить статус платежа" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Ошибка -->
            <Border Background="#FFEBEE"
                    BorderBrush="#FFCDD2"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️  " FontSize="16" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               FontWeight="Medium"
                               FontSize="14"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 5. Нижняя панель действий -->
        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource SurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24,16">
            <Grid>
                <!-- Панель до оплаты -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка отмены брони -->
                    <Button Grid.Column="0"
                            Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding CancelBookingCommand}"
                            HorizontalAlignment="Left"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✖  " Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="Отменить бронь и вернуться" />
                        </StackPanel>
                    </Button>

                    <!-- Кнопка «Оплатить заказ» -->
                    <Button Grid.Column="1"
                            Command="{Binding PayCommand}"
                            Padding="28,12"
                            FontSize="15">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💳  " />
                            <TextBlock Text="Оплатить заказ" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Панель после успешной оплаты -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaid}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка печати маршрутной квитанции W-10 -->
                    <Button Grid.Column="0"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{Binding PrintDocumentsCommand}"
                            HorizontalAlignment="Left"
                            Padding="20,12"
                            FontSize="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨  " />
                            <TextBlock Text="Печать квитанций и билетов (W-10)" />
                        </StackPanel>
                    </Button>

                    <!-- Кнопка завершения и перехода к поиску -->
                    <Button Grid.Column="1"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding NavigateToSearchCommand}"
                            Padding="24,12"
                            FontSize="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Оформить новый билет →" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
